{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jc-live",
  "account_id": "<account_id>",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "jc-live-archives",
    "database_id": "<d1_database_id>",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "JC_ALLOWED_ORIGINS": "[\"https://jc-live.xgfox54.workers.dev\",\"https://jc-live-ykh1.vercel.app\"]"
  },
  "vpc_services": [{ "binding": "DESKTOP_LIVE", "service_id": "<vpc_service_id>" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
